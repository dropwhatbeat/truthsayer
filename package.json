{
  "name": "bsking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "tsx lib/db/migrate.ts",
    "db:seed": "tsx lib/db/seed.ts",
    "test": "vitest run",
    "pretest": "docker compose up -d && sleep 3",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:headed": "HEADED=true vitest run --config vitest.e2e.config.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@bsking/game-engine": "*",
    "@tanstack/react-query": "^5.100.9",
    "@types/bcrypt": "^6.0.0",
    "@vercel/analytics": "^2.0.1",
    "@xstate/react": "^6.1.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.15",
    "pg": "^8.20.0",
    "posthog-js": "^1.372.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "postcss": "^8",
    "puppeteer": "^24.43.0",
